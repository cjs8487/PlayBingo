{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "required": [],
    "description": "An incoming websocket message from the server telling the client of a change in room state or instructing it to take an action",
    "properties": {
        "players": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "teams",
                "spectators"
            ],
            "properties": {
                "teams": {
                    "items": {
                        "$ref": "./Team.json"
                    },
                    "type": "array"
                },
                "spectators": {
                    "items": {
                        "$ref": "./Player.json"
                    },
                    "type": "array"
                }
            }
        },
        "connectedPlayer": {
            "$ref": "./Player.json"
        },
        "timestamp": {
            "type": "string",
            "description": "ISO 8601 timestamp string when the message was generated by the server."
        }
    },
    "anyOf": [
        {
            "required": [
                "action",
                "message"
            ],
            "properties": {
                "action": {
                    "const": "chatSent"
                },
                "message": {
                    "$ref": "./ChatMessage.json"
                }
            }
        },
        {
            "required": [
                "action",
                "team"
            ],
            "properties": {
                "action": {
                    "const": "joinedTeam"
                },
                "team": {
                    "$ref": "./Team.json"
                }
            }
        },
        {
            "required": [
                "action",
                "team"
            ],
            "properties": {
                "action": {
                    "const": "updatedTeam"
                },
                "team": {
                    "$ref": "./Team.json"
                }
            }
        },
        {
            "required": [
                "action",
                "row",
                "col",
                "cell"
            ],
            "properties": {
                "action": {
                    "const": "board:cellUpdate"
                },
                "row": {
                    "type": "number"
                },
                "col": {
                    "type": "number"
                },
                "cell": {
                    "$ref": "./Cell.json"
                }
            }
        },
        {
            "required": [
                "action",
                "board"
            ],
            "properties": {
                "action": {
                    "const": "syncBoard"
                },
                "board": {
                    "$ref": "./Board.json"
                }
            }
        },
        {
            "required": [
                "action",
                "board",
                "chatHistory"
            ],
            "properties": {
                "action": {
                    "const": "connected"
                },
                "board": {
                    "$ref": "./Board.json"
                },
                "chatHistory": {
                    "type": "array",
                    "items": {
                        "anyOf": [
                            {
                                "$ref": "./ChatMessage.json"
                            },
                            {
                                "$ref": "#/$defs/RoomAnnouncement"
                            }
                        ]
                    }
                },
                "roomData": {
                    "$ref": "./RoomData.json"
                },
                "chatEnabled": {
                    "type": "boolean"
                }
            }
        },
        {
            "required": [
                "action"
            ],
            "properties": {
                "action": {
                    "const": "unauthorized"
                }
            }
        },
        {
            "required": [
                "action"
            ],
            "properties": {
                "action": {
                    "const": "disconnected"
                }
            }
        },
        {
            "required": [
                "action",
                "roomData"
            ],
            "properties": {
                "action": {
                    "const": "updateRoomData"
                },
                "roomData": {
                    "$ref": "./RoomData.json"
                }
            }
        },
        {
            "required": [
                "action",
                "players",
                "racetimeConnection"
            ],
            "properties": {
                "action": {
                    "const": "syncRaceData"
                },
                "players": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                        "teams",
                        "spectators"
                    ],
                    "properties": {
                        "teams": {
                            "items": {
                                "$ref": "./Team.json"
                            },
                            "type": "array"
                        },
                        "spectators": {
                            "items": {
                                "$ref": "./Player.json"
                            },
                            "type": "array"
                        }
                    }
                },
                "racetimeConnection": {
                    "$ref": "./RoomData.json#/$defs/RacetimeConnection"
                }
            }
        },
        {
            "required": [
                "action"
            ],
            "properties": {
                "action": {
                    "const": "forbidden"
                }
            }
        },
        {
            "required": [
                "action",
                "authToken"
            ],
            "properties": {
                "action": {
                    "const": "reauthenticate"
                },
                "authToken": {
                    "type": "string"
                }
            }
        },
        {
            "required": [
                "action",
                "message"
            ],
            "properties": {
                "action": {
                    "const": "system:message"
                },
                "message": {
                    "$ref": "./ChatMessage.json"
                }
            }
        },
        {
            "$ref": "#/$defs/RoomAnnouncement"
        }
    ],
    "unevaluatedProperties": false,
    "$defs": {
        "AnnouncementTeam": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "name",
                "color"
            ],
            "properties": {
                "name": {
                    "type": "string"
                },
                "color": {
                    "type": "string"
                }
            }
        },
        "AnnouncementPlayer": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "nickname",
                "teamsEnabled"
            ],
            "properties": {
                "nickname": {
                    "type": "string"
                },
                "teamsEnabled": {
                    "type": "boolean"
                },
                "team": {
                    "$ref": "#/$defs/AnnouncementTeam"
                }
            }
        },
        "RoomAnnouncement": {
            "type": "object",
            "required": [
                "timestamp"
            ],
            "properties": {
                "timestamp": {
                    "type": "string",
                    "format": "date-time"
                },
                "startedAt": {
                    "type": "string",
                    "format": "date-time"
                }
            },
            "anyOf": [
                {
                    "required": [
                        "action",
                        "player"
                    ],
                    "properties": {
                        "action": {
                            "const": "players:join"
                        },
                        "player": {
                            "$ref": "#/$defs/AnnouncementPlayer"
                        }
                    }
                },
                {
                    "required": [
                        "action",
                        "player"
                    ],
                    "properties": {
                        "action": {
                            "const": "players:leave"
                        },
                        "player": {
                            "$ref": "#/$defs/AnnouncementPlayer"
                        }
                    }
                },
                {
                    "required": [
                        "action",
                        "player"
                    ],
                    "properties": {
                        "action": {
                            "const": "board:revealed"
                        },
                        "player": {
                            "$ref": "#/$defs/AnnouncementPlayer"
                        }
                    }
                },
                {
                    "required": [
                        "action",
                        "player",
                        "newColor"
                    ],
                    "properties": {
                        "action": {
                            "const": "player:colorChanged"
                        },
                        "player": {
                            "$ref": "#/$defs/AnnouncementPlayer"
                        },
                        "newColor": {
                            "type": "string"
                        }
                    }
                },
                {
                    "required": [
                        "action",
                        "player",
                        "row",
                        "col"
                    ],
                    "properties": {
                        "action": {
                            "const": "board:goalMarked"
                        },
                        "player": {
                            "$ref": "#/$defs/AnnouncementPlayer"
                        },
                        "row": {
                            "type": "number"
                        },
                        "col": {
                            "type": "number"
                        },
                        "goal": {
                            "type": "string"
                        }
                    }
                },
                {
                    "required": [
                        "action",
                        "player",
                        "row",
                        "col"
                    ],
                    "properties": {
                        "action": {
                            "const": "board:goalUnmarked"
                        },
                        "player": {
                            "$ref": "#/$defs/AnnouncementPlayer"
                        },
                        "row": {
                            "type": "number"
                        },
                        "col": {
                            "type": "number"
                        },
                        "goal": {
                            "type": "string"
                        }
                    }
                },
                {
                    "required": [
                        "action",
                        "team",
                        "teamDisplayName",
                        "mode"
                    ],
                    "properties": {
                        "action": {
                            "const": "team:lineCompleted"
                        },
                        "team": {
                            "$ref": "#/$defs/AnnouncementTeam"
                        },
                        "teamDisplayName": {
                            "type": "string"
                        },
                        "mode": {
                            "enum": [
                                "LINES",
                                "BLACKOUT",
                                "LOCKOUT"
                            ]
                        }
                    }
                },
                {
                    "required": [
                        "action",
                        "team",
                        "teamDisplayName",
                        "mode"
                    ],
                    "properties": {
                        "action": {
                            "const": "team:finished"
                        },
                        "team": {
                            "$ref": "#/$defs/AnnouncementTeam"
                        },
                        "teamDisplayName": {
                            "type": "string"
                        },
                        "mode": {
                            "enum": [
                                "LINES",
                                "BLACKOUT",
                                "LOCKOUT"
                            ]
                        }
                    }
                },
                {
                    "required": [
                        "action",
                        "team",
                        "teamDisplayName",
                        "mode"
                    ],
                    "properties": {
                        "action": {
                            "const": "team:unfinished"
                        },
                        "team": {
                            "$ref": "#/$defs/AnnouncementTeam"
                        },
                        "teamDisplayName": {
                            "type": "string"
                        },
                        "mode": {
                            "enum": [
                                "LINES",
                                "BLACKOUT",
                                "LOCKOUT"
                            ]
                        }
                    }
                },
                {
                    "required": [
                        "action"
                    ],
                    "properties": {
                        "action": {
                            "const": "board:regenerated"
                        }
                    }
                },
                {
                    "required": [
                        "action"
                    ],
                    "properties": {
                        "action": {
                            "const": "timer:started"
                        }
                    }
                },
                {
                    "required": [
                        "action"
                    ],
                    "properties": {
                        "action": {
                            "const": "timer:reset"
                        }
                    }
                },
                {
                    "required": [
                        "action"
                    ],
                    "properties": {
                        "action": {
                            "const": "timer:stopped"
                        }
                    }
                },
                {
                    "required": [
                        "action",
                        "player"
                    ],
                    "properties": {
                        "action": {
                            "const": "players:startedSpectating"
                        },
                        "player": {
                            "$ref": "#/$defs/AnnouncementPlayer"
                        }
                    }
                },
                {
                    "required": [
                        "action",
                        "player"
                    ],
                    "properties": {
                        "action": {
                            "const": "players:startedPlaying"
                        },
                        "player": {
                            "$ref": "#/$defs/AnnouncementPlayer"
                        }
                    }
                },
                {
                    "required": [
                        "action",
                        "player"
                    ],
                    "properties": {
                        "action": {
                            "const": "team:joined"
                        },
                        "player": {
                            "$ref": "#/$defs/AnnouncementPlayer"
                        }
                    }
                },
                {
                    "required": [
                        "action",
                        "player"
                    ],
                    "properties": {
                        "action": {
                            "const": "team:renamed"
                        },
                        "player": {
                            "$ref": "#/$defs/AnnouncementPlayer"
                        }
                    }
                },
                {
                    "required": [
                        "action",
                        "player",
                        "message"
                    ],
                    "properties": {
                        "action": {
                            "const": "player:chat"
                        },
                        "player": {
                            "$ref": "#/$defs/AnnouncementPlayer"
                        },
                        "message": {
                            "type": "string"
                        }
                    }
                },
                {
                    "required": [
                        "action",
                        "team",
                        "teamDisplayName"
                    ],
                    "properties": {
                        "action": {
                            "const": "team:disbanded"
                        },
                        "team": {
                            "$ref": "#/$defs/AnnouncementTeam"
                        },
                        "teamDisplayName": {
                            "type": "string"
                        }
                    }
                },
                {
                    "required": [
                        "action",
                        "url"
                    ],
                    "properties": {
                        "action": {
                            "const": "racetime:created"
                        },
                        "url": {
                            "type": "string"
                        }
                    }
                },
                {
                    "required": [
                        "action"
                    ],
                    "properties": {
                        "action": {
                            "const": "room:inactivityWarning"
                        }
                    }
                },
                {
                    "required": [
                        "action"
                    ],
                    "properties": {
                        "action": {
                            "const": "room:closing"
                        }
                    }
                }
            ]
        }
    }
}
