{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "required": [],
    "description": "An incoming websocket message from the server telling the client of a change in room state or instructing it to take an action",
    "properties": {
        "players": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "teams",
                "spectators"
            ],
            "properties": {
                "teams": {
                    "items": {
                        "$ref": "./Team.json"
                    },
                    "type": "array"
                },
                "spectators": {
                    "items": {
                        "$ref": "./Player.json"
                    },
                    "type": "array"
                }
            }
        },
        "connectedPlayer": {
            "$ref": "./Player.json"
        },
        "timestamp": {
            "type": "string",
            "description": "ISO 8601 timestamp string when the message was generated by the server."
        }
    },
    "anyOf": [
        {
            "required": [
                "action",
                "message"
            ],
            "properties": {
                "action": {
                    "const": "chatSent"
                },
                "message": {
                    "$ref": "./ChatMessage.json"
                }
            }
        },
        {
            "required": [
                "action",
                "team"
            ],
            "properties": {
                "action": {
                    "const": "joinedTeam"
                },
                "team": {
                    "$ref": "./Team.json"
                }
            }
        },
        {
            "required": [
                "action",
                "team"
            ],
            "properties": {
                "action": {
                    "const": "updatedTeam"
                },
                "team": {
                    "$ref": "./Team.json"
                }
            }
        },
        {
            "required": [
                "action",
                "row",
                "col",
                "cell"
            ],
            "properties": {
                "action": {
                    "const": "board:cellUpdate"
                },
                "row": {
                    "type": "number"
                },
                "col": {
                    "type": "number"
                },
                "cell": {
                    "$ref": "./Cell.json"
                }
            }
        },
        {
            "required": [
                "action",
                "board"
            ],
            "properties": {
                "action": {
                    "const": "syncBoard"
                },
                "board": {
                    "$ref": "./Board.json"
                }
            }
        },
        {
            "required": [
                "action",
                "board",
                "chatHistory"
            ],
            "properties": {
                "action": {
                    "const": "connected"
                },
                "board": {
                    "$ref": "./Board.json"
                },
                "chatHistory": {
                    "type": "array",
                    "items": {
                        "$ref": "./ChatMessage.json"
                    }
                },
                "roomData": {
                    "$ref": "./RoomData.json"
                },
                "chatEnabled": {
                    "type": "boolean"
                }
            }
        },
        {
            "required": [
                "action"
            ],
            "properties": {
                "action": {
                    "const": "unauthorized"
                }
            }
        },
        {
            "required": [
                "action"
            ],
            "properties": {
                "action": {
                    "const": "disconnected"
                }
            }
        },
        {
            "required": [
                "action",
                "roomData"
            ],
            "properties": {
                "action": {
                    "const": "updateRoomData"
                },
                "roomData": {
                    "$ref": "./RoomData.json"
                }
            }
        },
        {
            "required": [
                "action",
                "players",
                "racetimeConnection"
            ],
            "properties": {
                "action": {
                    "const": "syncRaceData"
                },
                "players": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                        "teams",
                        "spectators"
                    ],
                    "properties": {
                        "teams": {
                            "items": {
                                "$ref": "./Team.json"
                            },
                            "type": "array"
                        },
                        "spectators": {
                            "items": {
                                "$ref": "./Player.json"
                            },
                            "type": "array"
                        }
                    }
                },
                "racetimeConnection": {
                    "$ref": "./RoomData.json#/$defs/RacetimeConnection"
                }
            }
        },
        {
            "required": [
                "action"
            ],
            "properties": {
                "action": {
                    "const": "forbidden"
                }
            }
        },
        {
            "required": [
                "action",
                "authToken"
            ],
            "properties": {
                "action": {
                    "const": "reauthenticate"
                },
                "authToken": {
                    "type": "string"
                }
            }
        },
        {
            "required": [
                "action"
            ],
            "properties": {
                "action": {
                    "const": "timer:started"
                }
            }
        },
        {
            "required": [
                "action",
                "player"
            ],
            "properties": {
                "action": {
                    "const": "players:join"
                },
                "player": {
                    "$ref": "./Player.json"
                }
            }
        },
        {
            "required": [
                "action",
                "player"
            ],
            "properties": {
                "action": {
                    "const": "players:leave"
                },
                "player": {
                    "$ref": "./Player.json"
                }
            }
        },
        {
            "required": [
                "action",
                "player"
            ],
            "properties": {
                "action": {
                    "const": "player:finished"
                },
                "player": {
                    "$ref": "./Player.json"
                }
            }
        },
        {
            "required": [
                "action",
                "player"
            ],
            "properties": {
                "action": {
                    "const": "player:unfinished"
                },
                "player": {
                    "$ref": "./Player.json"
                }
            }
        },
        {
            "required": [
                "action",
                "player"
            ],
            "properties": {
                "action": {
                    "const": "board:revealed"
                },
                "player": {
                    "$ref": "./Player.json"
                }
            }
        },
        {
            "required": [
                "action",
                "player",
                "newColor"
            ],
            "properties": {
                "action": {
                    "const": "player:colorChanged"
                },
                "player": {
                    "$ref": "./Player.json"
                },
                "newColor": {
                    "type": "string"
                }
            }
        },
        {
            "required": [
                "action",
                "cell",
                "row",
                "col",
                "player"
            ],
            "properties": {
                "action": {
                    "const": "board:goalMarked"
                },
                "cell": {
                    "$ref": "./Cell.json"
                },
                "row": {
                    "type": "number"
                },
                "col": {
                    "type": "number"
                },
                "player": {
                    "$ref": "./Player.json"
                }
            }
        },
        {
            "required": [
                "action",
                "cell",
                "row",
                "col",
                "player"
            ],
            "properties": {
                "action": {
                    "const": "board:goalUnmarked"
                },
                "cell": {
                    "$ref": "./Cell.json"
                },
                "row": {
                    "type": "number"
                },
                "col": {
                    "type": "number"
                },
                "player": {
                    "$ref": "./Player.json"
                }
            }
        },
        {
            "required": [
                "action",
                "board",
                "options"
            ],
            "properties": {
                "action": {
                    "const": "board:regenerated"
                },
                "board": {
                    "type": "array",
                    "items": {
                        "type": "array",
                        "items": {
                            "$ref": "./Cell.json#/$defs/RevealedCell"
                        }
                    }
                },
                "options": {
                    "oneOf": [
                        {
                            "type": "object",
                            "additionalProperties": false,
                            "required": [
                                "mode"
                            ],
                            "properties": {
                                "mode": {
                                    "const": "Random"
                                },
                                "seed": {
                                    "type": "number"
                                }
                            }
                        },
                        {
                            "type": "object",
                            "additionalProperties": false,
                            "required": [
                                "mode"
                            ],
                            "properties": {
                                "mode": {
                                    "const": "SRLv5"
                                },
                                "seed": {
                                    "type": "number"
                                }
                            }
                        },
                        {
                            "type": "object",
                            "additionalProperties": false,
                            "required": [
                                "mode",
                                "difficulty"
                            ],
                            "properties": {
                                "mode": {
                                    "const": "Difficulty"
                                },
                                "seed": {
                                    "type": "number"
                                },
                                "difficulty": {
                                    "type": "string"
                                }
                            }
                        }
                    ]
                }
            }
        },
        {
            "required": [
                "action",
                "message"
            ],
            "properties": {
                "action": {
                    "const": "system:message"
                },
                "message": {
                    "$ref": "./ChatMessage.json"
                }
            }
        },
        {
            "required": [
                "action"
            ],
            "properties": {
                "action": {
                    "const": "timer:reset"
                }
            }
        },
        {
            "required": [
                "action"
            ],
            "properties": {
                "action": {
                    "const": "timer:stopped"
                }
            }
        }
    ],
    "unevaluatedProperties": false
}
