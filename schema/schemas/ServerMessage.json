{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "required": [],
    "description": "An incoming websocket message from the server telling the client of a change in room state or instructing it to take an action",
    "properties": {
        "players": {
            "type": "array",
            "items": {
                "$ref": "./Player.json"
            }
        },
        "connectedPlayer": {
            "$ref": "./Player.json"
        },
        "timestamp": {
            "type": "string",
            "description": "ISO 8601 timestamp string when the message was generated by the server."
        }
    },
    "anyOf": [
        {
            "required": [
                "action",
                "message"
            ],
            "additionalProperties": false,
            "properties": {
                "action": "chatSent",
                "message": {
                    "$ref": "./ChatMessage.json"
                }
            }
        },
        {
            "required": [
                "action",
                "row",
                "col",
                "cell"
            ],
            "additionalProperties": false,
            "properties": {
                "action": "board:cellUpdate",
                "row": {
                    "type": "number"
                },
                "col": {
                    "type": "number"
                },
                "cell": {
                    "$ref": "./Cell.json"
                }
            }
        },
        {
            "required": [
                "action",
                "board"
            ],
            "additionalProperties": false,
            "properties": {
                "action": "syncBoard",
                "board": {
                    "$ref": "./Board.json"
                }
            }
        },
        {
            "required": [
                "action",
                "board",
                "chatHistory",
                "players",
                "connectedPlayer"
            ],
            "additionalProperties": false,
            "properties": {
                "action": "connected",
                "board": {
                    "$ref": "./Board.json"
                },
                "chatHistory": {
                    "type": "array",
                    "items": {
                        "$ref": "./ChatMessage.json"
                    }
                },
                "roomData": {
                    "$ref": "./RoomData.json"
                },
                "chatEnabled": {
                    "type": "boolean"
                }
            }
        },
        {
            "required": [
                "action"
            ],
            "additionalProperties": false,
            "properties": {
                "action": "unauthorized"
            }
        },
        {
            "required": [
                "action"
            ],
            "additionalProperties": false,
            "properties": {
                "action": "disconnected"
            }
        },
        {
            "required": [
                "action",
                "roomData"
            ],
            "additionalProperties": false,
            "properties": {
                "action": "updateRoomData",
                "roomData": {
                    "$ref": "./RoomData.json"
                }
            }
        },
        {
            "required": [
                "action",
                "players",
                "racetimeConnection"
            ],
            "additionalProperties": false,
            "properties": {
                "action": "syncRaceData",
                "players": {
                    "type": "array",
                    "items": {
                        "$ref": "./Player.json"
                    }
                },
                "racetimeConnection": {
                    "$ref": "./RoomData.json#/$defs/RacetimeConnection"
                }
            }
        },
        {
            "required": [
                "action"
            ],
            "additionalProperties": false,
            "properties": {
                "action": "forbidden"
            }
        },
        {
            "required": [
                "action",
                "authToken"
            ],
            "additionalProperties": false,
            "properties": {
                "action": "reauthenticate",
                "authToken": {
                    "type": "string"
                }
            }
        },
        {
            "required": [
                "action"
            ],
            "additionalProperties": false,
            "properties": {
                "action": "timer:started"
            }
        },
        {
            "required": [
                "action",
                "player"
            ],
            "additionalProperties": false,
            "properties": {
                "action": "players:join",
                "player": {
                    "$ref": "./Player.json"
                }
            }
        },
        {
            "required": [
                "action",
                "player"
            ],
            "additionalProperties": false,
            "properties": {
                "action": "players:leave",
                "player": {
                    "$ref": "./Player.json"
                }
            }
        },
        {
            "required": [
                "action",
                "player"
            ],
            "additionalProperties": false,
            "properties": {
                "action": "player:finished",
                "player": {
                    "$ref": "./Player.json"
                }
            }
        },
        {
            "required": [
                "action",
                "player"
            ],
            "additionalProperties": false,
            "properties": {
                "action": "player:unfinished",
                "player": {
                    "$ref": "./Player.json"
                }
            }
        },
        {
            "required": [
                "action",
                "player"
            ],
            "additionalProperties": false,
            "properties": {
                "action": "board:revealed",
                "player": {
                    "$ref": "./Player.json"
                }
            }
        },
        {
            "required": [
                "action",
                "player",
                "newColor"
            ],
            "additionalProperties": false,
            "properties": {
                "action": "player:colorChanged",
                "player": {
                    "$ref": "./Player.json"
                },
                "newColor": {
                    "type": "string"
                }
            }
        },
        {
            "required": [
                "action",
                "cell",
                "row",
                "col",
                "player"
            ],
            "additionalProperties": false,
            "properties": {
                "action": "board:goalMarked",
                "cell": {
                    "$ref": "./Cell.json"
                },
                "row": {
                    "type": "number"
                },
                "col": {
                    "type": "number"
                },
                "player": {
                    "$ref": "./Player.json"
                }
            }
        },
        {
            "required": [
                "action",
                "cell",
                "row",
                "col",
                "player"
            ],
            "additionalProperties": false,
            "properties": {
                "action": "board:goalUnmarked",
                "cell": {
                    "$ref": "./Cell.json"
                },
                "row": {
                    "type": "number"
                },
                "col": {
                    "type": "number"
                },
                "player": {
                    "$ref": "./Player.json"
                }
            }
        },
        {
            "required": [
                "action",
                "board"
            ],
            "additionalProperties": false,
            "properties": {
                "action": "board:regenerated",
                "board": {
                    "$ref": "./Board.json"
                }
            }
        },
        {
            "required": [
                "action",
                "message"
            ],
            "additionalProperties": false,
            "properties": {
                "action": "system:message",
                "message": {
                    "$ref": "./ChatMessage.json"
                }
            }
        },
        {
            "required": [
                "action"
            ],
            "additionalProperties": false,
            "properties": {
                "action": "timer:reset"
            }
        },
        {
            "required": [
                "action"
            ],
            "additionalProperties": false,
            "properties": {
                "action": "timer:stopped"
            }
        }
    ]
}